{
  "extends": "@repo/foundation-typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../../packages/ui/theme/tsconfig.json" }],
  "include": [
    "src",
    "next-env.d.ts",
    "next.config.ts",
    "vitest.setup.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "@types/**/*.d.ts",
    "../../packages/ui/panel/src/register-all.ts"
  ],
  "exclude": ["node_modules", ".next", ".turbo", "src/components/quarantine"]
}
