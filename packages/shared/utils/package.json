{
  "name": "@repo/shared-utils",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,css,md}\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/shared-contracts": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@repo/foundation-eslint-config": "workspace:*",
    "@repo/foundation-prettier-config": "workspace:*",
    "@repo/foundation-typescript-config": "workspace:*",
    "@repo/foundation-vitest-config": "workspace:*",
    "@repo/foundation-vitest-utils": "workspace:*",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "next": "16.3.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "next": "^16.3.3"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "exports": {
    "./classnames": "./src/ui/classnames.ts",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./ui/classnames": "./src/ui/classnames.ts",
    "./server/*": "./src/server/*.ts",
    "./server": "./src/server/index.ts"
  }
}
